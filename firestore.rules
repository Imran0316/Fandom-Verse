rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- Users ----
    match /users/{uid} {
      allow read: if signedIn();

      // Create: own doc only, always starts as fan — never admin.
      allow create: if isSelf(uid)
        && request.resource.data.role == 'fan'
        && request.resource.data.uid == uid;

      // Self: edit profile fields only (role must stay the same), except
      // the one-way fan → seller upgrade. Admins may set fan/seller/admin
      // on any user (Admin Console). New accounts always start as fan.
      allow update: if (
          isSelf(uid)
          && request.resource.data.role == resource.data.role
        ) || (
          isSelf(uid)
          && resource.data.role == 'fan'
          && request.resource.data.role == 'seller'
          && request.resource.data.role != 'admin'
        ) || (
          isAdmin()
          && request.resource.data.role in ['fan', 'seller', 'admin']
        );

      allow delete: if isAdmin();

      match /cart/{productId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ---- Categories (admin-managed, everyone signed-in can read) ----
    match /categories/{categoryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---- V1 Content: fandoms + content categories (admin-managed) ----
    match /fandoms/{fandomId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /contentCategories/{categoryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---- V1 Content: unified `contents` collection ----
    // Admins manage everything. Fans may only read published docs — the
    // client hides drafts, but rules guarantee it.
    match /contents/{contentId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.status == 'published');
      allow create: if isAdmin()
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- V1 Bookmarks: fans own their saved library ----
    match /bookmarks/{bookmarkId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ---- Communities / posts / merch / events (Phase 1+) ----
    match /communities/{communityId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin()
        || resource.data.ownerUid == request.auth.uid
        // Join/leave bumps memberCount; posting bumps postCount — any
        // signed-in member may do exactly those counter writes.
        || (signedIn()
            && request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasOnly(['memberCount', 'postCount']));
      allow delete: if isAdmin()
        || resource.data.ownerUid == request.auth.uid;

      match /members/{memberUid} {
        allow read: if signedIn();
        allow create: if signedIn() && memberUid == request.auth.uid;
        allow delete: if isAdmin()
          || memberUid == request.auth.uid
          || get(/databases/$(database)/documents/communities/$(communityId)).data.ownerUid == request.auth.uid;
        allow update: if isAdmin()
          || memberUid == request.auth.uid
          || get(/databases/$(database)/documents/communities/$(communityId)).data.ownerUid == request.auth.uid;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin()
        || resource.data.authorUid == request.auth.uid;
      allow delete: if isAdmin()
        || resource.data.authorUid == request.auth.uid;

      match /likes/{likeUid} {
        allow read: if signedIn();
        allow create: if signedIn() && likeUid == request.auth.uid;
        allow delete: if signedIn() && likeUid == request.auth.uid;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isAdmin()
          || resource.data.authorUid == request.auth.uid;
        allow delete: if isAdmin()
          || resource.data.authorUid == request.auth.uid;
      }

      match /reposts/{repostUid} {
        allow read: if signedIn();
        allow create: if signedIn() && repostUid == request.auth.uid;
        allow delete: if signedIn() && repostUid == request.auth.uid;
      }
    }

    match /merch/{productId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && (myRole() == 'seller' || isAdmin());
      allow update, delete: if isAdmin()
        || resource.data.sellerUid == request.auth.uid;
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ---- Orders ----
    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.buyerUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.buyerUid == request.auth.uid;
      allow update, delete: if isAdmin()
        || resource.data.buyerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
