rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A counter field may only be added (initial 0/1), unchanged, or move
    // by exactly ±1 (batch like / repost / follow bumps from other users).
    function counterOnly(key) {
      return (key in request.resource.data)
        && (
          !(key in resource.data)
            ? request.resource.data[key] == 0 || request.resource.data[key] == 1
            : request.resource.data[key] == resource.data[key]
              || request.resource.data[key] == resource.data[key] + 1
              || request.resource.data[key] == resource.data[key] - 1
        );
    }

    // Signed-in users may bump exactly the post counters and nothing else
    // (liking / commenting / reposting someone else's post).
    function validPostCounters() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['likeCount', 'commentCount', 'repostCount'])
        && counterOnly('likeCount')
        && counterOnly('commentCount')
        && counterOnly('repostCount');
    }

    // Comment counters: likes / replies (±1) and the reactions tally (map).
    function validCommentCounters() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['likeCount', 'replyCount', 'reactions'])
        && counterOnly('likeCount')
        && counterOnly('replyCount');
    }

    // Reel counters: likes / comments bump by ±1 (reels have no reposts).
    function validReelCounters() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['likeCount', 'commentCount'])
        && counterOnly('likeCount')
        && counterOnly('commentCount');
    }

    // Follow counters on any user's profile (accept / unfollow bumps).
    function validFollowCounters() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['followerCount', 'followingCount'])
        && counterOnly('followerCount')
        && counterOnly('followingCount');
    }

    // Merch stats that non-owners may update: review aggregates
    // (rating/reviewCount — rewritten whenever a buyer reviews) and sales
    // stats (soldCount/stock — bumped at checkout). Everything else on a
    // merch doc stays owner/admin-only.
    function validMerchStats() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let touchesRating = changed.hasAny(['rating', 'reviewCount']);
      let touchesSales = changed.hasAny(['soldCount', 'stock']);
      let newCount = request.resource.data.get('reviewCount', 0);
      let oldCount = resource.data.get('reviewCount', 0);
      let newSold = request.resource.data.get('soldCount', 0);
      let oldSold = resource.data.get('soldCount', 0);
      // Untracked stock (field absent) may never be introduced by a buyer.
      let stockOk = !('stock' in resource.data)
        ? !('stock' in request.resource.data)
        : ('stock' in request.resource.data
            && request.resource.data.stock <= resource.data.stock
            && request.resource.data.stock >= 0);
      let ratingOk = !touchesRating || touchesSales
        ? false
        : (changed.hasAll(['rating', 'reviewCount'])
            && request.resource.data.rating >= 0
            && request.resource.data.rating <= 5
            && newCount >= 0
            && (newCount == oldCount + 1
              || newCount == oldCount
              || newCount == oldCount - 1));
      let salesOk = !touchesSales || touchesRating
        ? false
        : ('soldCount' in request.resource.data
            && newSold >= oldSold
            && newSold - oldSold <= 100
            && stockOk);
      return changed.hasOnly(['rating', 'reviewCount', 'soldCount', 'stock'])
        && (touchesRating || touchesSales)
        && (ratingOk || salesOk);
    }

    // ---- Users ----
    match /users/{uid} {
      allow read: if signedIn();

      // Create: own doc only, always starts as fan — never admin.
      allow create: if isSelf(uid)
        && request.resource.data.role == 'fan'
        && request.resource.data.uid == uid;

      // Self: edit profile fields only (role must stay the same), except
      // the one-way fan → seller upgrade. Admins may set fan/seller/admin
      // on any user (Admin Console). New accounts always start as fan.
      // Anyone signed-in may bump follower/following counters by ±1 —
      // that is how follow requests and unfollows update the other side.
      allow update: if (
          isSelf(uid)
          && request.resource.data.role == resource.data.role
        ) || (
          isSelf(uid)
          && resource.data.role == 'fan'
          && request.resource.data.role == 'seller'
          && request.resource.data.role != 'admin'
        ) || (
          isAdmin()
          && request.resource.data.role in ['fan', 'seller', 'admin']
        ) || (
          signedIn()
          && validFollowCounters()
        );

      allow delete: if isAdmin();

      match /cart/{productId} {
        allow read, write: if isSelf(uid);
      }

      // ---- Follow graph ----
      // followers/{followerUid}: the target maintains their own follower
      // list on accept (only they may write into it, so requests cannot be
      // bypassed). The follower may remove themselves (unfollow).
      match /followers/{followerUid} {
        allow read: if signedIn();
        allow create: if isSelf(uid);
        allow delete: if isSelf(uid) || followerUid == request.auth.uid;
      }

      // following/{targetUid}: written by the target on accept — they may
      // only ever name themselves as the target of the edge.
      match /following/{targetUid} {
        allow read: if signedIn();
        allow create: if isSelf(uid) || targetUid == request.auth.uid;
        allow delete: if isSelf(uid) || targetUid == request.auth.uid;
      }

      // followRequests/{fromUid}: pending inbound requests. The requester
      // writes / cancels their own doc; the target reads / accepts / declines.
      match /followRequests/{fromUid} {
        allow read: if isSelf(uid) || fromUid == request.auth.uid;
        allow create: if fromUid == request.auth.uid;
        allow delete: if isSelf(uid) || fromUid == request.auth.uid;
      }

      // Activity notifications (likes / comments / replies / follow
      // requests). Created by the actor with their own uid stamped on the
      // doc; only the recipient reads, marks or clears them. The actor may
      // remove their own notification (withdrawing a follow request).
      match /notifications/{notificationId} {
        allow read: if isSelf(uid);
        allow create: if signedIn()
          && request.resource.data.recipientUid == uid
          && (
            request.resource.data.actorUid == request.auth.uid
            || request.resource.data.actorUid == 'system'
          );
        allow update: if isSelf(uid);
        allow delete: if isSelf(uid)
          || resource.data.actorUid == request.auth.uid
          || resource.data.actorUid == 'system';
      }

      match /devices/{deviceId} {
        allow read: if isSelf(uid);
        allow create, update: if isSelf(uid)
          && request.resource.data.platform in ['android', 'ios', 'web'];
        allow delete: if isSelf(uid);
      }
    }

    // ---- Categories (admin-managed; public read feeds the signed-out
    //      explore mode and the offline cache) ----
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---- V1 Content: fandoms + content categories (admin-managed) ----
    match /fandoms/{fandomId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /contentCategories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---- V1 Content: unified `contents` collection ----
    // Admins manage everything. Published docs are publicly readable so
    // signed-out users can browse; drafts stay admin-only.
    match /contents/{contentId} {
      allow read: if isAdmin()
        || resource.data.status == 'published';
      allow create: if isAdmin()
        && request.resource.data.status in ['draft', 'published']
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- V1 Bookmarks: fans own their saved library ----
    match /bookmarks/{bookmarkId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ---- Communities / posts / merch / events (Phase 1+) ----
    // Reads are public: the explore-first flow shows real content to
    // signed-out users and the offline cache keeps it available with no
    // connection. All writes still require auth.
    match /communities/{communityId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isAdmin()
        || resource.data.ownerUid == request.auth.uid
        // Join/leave bumps memberCount; posting bumps postCount — any
        // signed-in member may do exactly those counter writes.
        || (signedIn()
            && request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasOnly(['memberCount', 'postCount']));
      allow delete: if isAdmin()
        || resource.data.ownerUid == request.auth.uid;

      match /members/{memberUid} {
        allow read: if signedIn();
        allow create: if signedIn() && memberUid == request.auth.uid;
        allow delete: if isAdmin()
          || memberUid == request.auth.uid
          || get(/databases/$(database)/documents/communities/$(communityId)).data.ownerUid == request.auth.uid;
        allow update: if isAdmin()
          || memberUid == request.auth.uid
          || get(/databases/$(database)/documents/communities/$(communityId)).data.ownerUid == request.auth.uid;
      }
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin()
        || resource.data.authorUid == request.auth.uid
        // Likes / comments / reposts bump counters on anyone's post.
        || (signedIn() && validPostCounters());
      allow delete: if isAdmin()
        || resource.data.authorUid == request.auth.uid;

      match /likes/{likeUid} {
        allow read: if signedIn();
        allow create: if signedIn() && likeUid == request.auth.uid;
        allow delete: if signedIn() && likeUid == request.auth.uid;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid;
        // Authors may edit/delete their comment; anyone signed-in may bump
        // the like/reply counters and the reactions tally by batch writes.
        allow update: if isAdmin()
          || resource.data.authorUid == request.auth.uid
          || (signedIn() && validCommentCounters());
        allow delete: if isAdmin()
          || resource.data.authorUid == request.auth.uid;

        // Liking a comment: one like doc per user.
        match /likes/{likeUid} {
          allow read: if signedIn();
          allow create: if signedIn() && likeUid == request.auth.uid;
          allow delete: if signedIn() && likeUid == request.auth.uid;
        }

        // Emoji reactions: one reaction doc per user (the chosen emoji).
        match /reactions/{reactUid} {
          allow read: if signedIn();
          allow create, update: if signedIn() && reactUid == request.auth.uid;
          allow delete: if signedIn() && reactUid == request.auth.uid;
        }

        // Replies to a comment.
        match /replies/{replyId} {
          allow read: if signedIn();
          allow create: if signedIn()
            && request.resource.data.authorUid == request.auth.uid;
          allow update: if isAdmin()
            || resource.data.authorUid == request.auth.uid;
          allow delete: if isAdmin()
            || resource.data.authorUid == request.auth.uid;
        }
      }

      match /reposts/{repostUid} {
        allow read: if signedIn();
        allow create: if signedIn() && repostUid == request.auth.uid;
        allow delete: if signedIn() && repostUid == request.auth.uid;
      }
    }

    // ---- Community reels: Cloudinary video + Firestore metadata ----
    match /reels/{reelId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin()
        || resource.data.authorUid == request.auth.uid
        // Anyone signed-in may bump like/comment counters (±1).
        || (signedIn() && validReelCounters());
      allow delete: if isAdmin()
        || resource.data.authorUid == request.auth.uid;

      match /likes/{likeUid} {
        allow read: if signedIn();
        allow create: if signedIn() && likeUid == request.auth.uid;
        allow delete: if signedIn() && likeUid == request.auth.uid;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isAdmin()
          || resource.data.authorUid == request.auth.uid;
        allow delete: if isAdmin()
          || resource.data.authorUid == request.auth.uid;
      }
    }

    match /merch/{productId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && (myRole() == 'seller' || isAdmin());
      allow update: if isAdmin()
        || resource.data.sellerUid == request.auth.uid
        // Buyers may only touch the stat fields (see validMerchStats).
        || (signedIn() && validMerchStats());
      allow delete: if isAdmin()
        || resource.data.sellerUid == request.auth.uid;

      // Product reviews: one doc per buyer (id = author uid), newest
      // activity first via the client's createdAt sort.
      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.productId == productId
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.text is string;
        allow update: if isAdmin()
          || resource.data.authorUid == request.auth.uid;
        allow delete: if isAdmin()
          || resource.data.authorUid == request.auth.uid;
      }
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || validEventRsvpUpdate(eventId);

      function validEventRsvpUpdate(eventId) {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let rsvpPath = /databases/$(database)/documents/events/$(eventId)/rsvps/$(request.auth.uid);
        let currentCount = resource.data.get('rsvpCount', 0);
        let nextCount = request.resource.data.get('rsvpCount', 0);
        return signedIn()
          && changed.hasOnly(['rsvpCount'])
          && counterOnly('rsvpCount')
          && (
            (!exists(rsvpPath)
              && existsAfter(rsvpPath)
              && nextCount == currentCount + 1)
            || (exists(rsvpPath)
              && !existsAfter(rsvpPath)
              && nextCount == (currentCount > 0 ? currentCount - 1 : 0))
          );
      }

      match /rsvps/{uid} {
        allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.eventId == eventId
          && request.resource.data.keys().hasOnly(['eventId', 'uid', 'createdAt'])
          && get(/databases/$(database)/documents/events/$(eventId)).data.get('isActive', true) == true
          && getAfter(/databases/$(database)/documents/events/$(eventId)).data.get('rsvpCount', 0)
            == get(/databases/$(database)/documents/events/$(eventId)).data.get('rsvpCount', 0) + 1;
        allow delete: if signedIn()
          && uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/events/$(eventId)).data.get('rsvpCount', 0)
            == (get(/databases/$(database)/documents/events/$(eventId)).data.get('rsvpCount', 0) > 0
              ? get(/databases/$(database)/documents/events/$(eventId)).data.get('rsvpCount', 0) - 1
              : 0);
        allow update: if false;
      }
    }

    // ---- Orders ----
    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.buyerUid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.buyerUid == request.auth.uid;
      allow update, delete: if isAdmin()
        || resource.data.buyerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
