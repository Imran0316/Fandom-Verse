rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---- Users ----
    match /users/{uid} {
      allow read: if signedIn();

      // Create: own doc only, always starts as fan — never admin.
      allow create: if isSelf(uid)
        && request.resource.data.role == 'fan'
        && request.resource.data.uid == uid;

      // Self: edit profile fields only (role must stay the same), except
      // the one-way fan → seller upgrade. Admins may set fan/seller/admin
      // on any user (Admin Console). New accounts always start as fan.
      allow update: if (
          isSelf(uid)
          && request.resource.data.role == resource.data.role
        ) || (
          isSelf(uid)
          && resource.data.role == 'fan'
          && request.resource.data.role == 'seller'
          && request.resource.data.role != 'admin'
        ) || (
          isAdmin()
          && request.resource.data.role in ['fan', 'seller', 'admin']
        );

      allow delete: if isAdmin();
    }

    // ---- Communities / posts / merch / events (Phase 1+) ----
    match /communities/{communityId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin()
        || resource.data.ownerUid == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if isAdmin()
        || resource.data.authorUid == request.auth.uid;
      allow delete: if isAdmin()
        || resource.data.authorUid == request.auth.uid;

      match /likes/{likeUid} {
        allow read: if signedIn();
        allow create: if signedIn() && likeUid == request.auth.uid;
        allow delete: if signedIn() && likeUid == request.auth.uid;
      }

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isAdmin()
          || resource.data.authorUid == request.auth.uid;
        allow delete: if isAdmin()
          || resource.data.authorUid == request.auth.uid;
      }

      match /reposts/{repostUid} {
        allow read: if signedIn();
        allow create: if signedIn() && repostUid == request.auth.uid;
        allow delete: if signedIn() && repostUid == request.auth.uid;
      }
    }

    match /merch/{productId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.sellerUid == request.auth.uid
        && (myRole() == 'seller' || isAdmin());
      allow update, delete: if isAdmin()
        || resource.data.sellerUid == request.auth.uid;
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
